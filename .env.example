PORT=3002
NODE_ENV=development

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=30d

DB_HOST=localhost
DB_PORT=3306
DB_NAME=bignlean
DB_USER=bhavya
DB_PASSWORD=bhavya123

TWOFACTOR_API_KEY=your_2factor_api_key
FIREBASE_PROJECT_ID=bignlean-fbffd
FIREBASE_DATABASE_URL=https://bignlean-fbffd-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
# Alternative to FIREBASE_SERVICE_ACCOUNT_PATH:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@bignlean-fbffd.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_PRIVATE_KEY_ID=your_private_key_id
# FIREBASE_CLIENT_ID=your_client_id
RAZORPAY_KEY_ID=your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret

# test/sandbox/mock simulate Xpressbees and do not create real shipments.
# live/prod/production calls the real Xpressbees API.
XPRESSBEES_MODE=test
XPRESSBEES_EMAIL=orders@example.com
XPRESSBEES_PASSWORD=replace_with_xpressbees_password
